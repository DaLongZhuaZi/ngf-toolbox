{
  "app": {
    // 签名说明: 本仓库不提交任何签名材料。本地调试签名由 DevEco Studio 首次打开工程时
    // 自动生成 (或在 工程结构 > Signing Configs 中配置); CI 构建会在构建前用
    // .github/scripts/strip_signing.py 剥离签名配置产出未签名 HAP, 发布签名走
    // sign-and-release.yml (v* tag + 仓库 Secrets), 与 airwavefootprints 仓一致。
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "ngf_framework",
      "srcPath": "./ngf_framework",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
